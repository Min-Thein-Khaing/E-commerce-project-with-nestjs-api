generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model cart_items {
  id        String   @id
  productId String
  quantity  Int
  cartId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  carts     carts    @relation(fields: [cartId], references: [id])
  products  products @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId, productId])
  @@map("cart_items")
}

model carts {
  id         String       @id
  userId     String
  checkOut   Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime
  cart_items cart_items[]
  users      users        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     orders[]

  @@index([userId, checkOut])
  @@map("carts")
}

model categories {
  id          String     @id
  name        String
  description String?
  slug        String     @unique
  imageUrl    String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  products    products[]

  @@index([slug, isActive])
  @@map("categories")
}

model order_items {
  id        String   @id
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime
  subTotal  Decimal? @db.Decimal(10, 2)
  orders    orders   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  products  products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId, productId])
  @@map("order_items")
}

model orders {
  id              String        @id
  orderNo         String        @unique
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  userId          String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  cartId          String?
  shippingAddress String?
  order_items     order_items[]
  carts           carts?        @relation(fields: [cartId], references: [id])
  users           users         @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments        payments[]

  @@index([id, userId, status, orderNo])
  @@map("orders")
}

model payments {
  id            String        @id
  status        PaymentStatus @default(PENDING)
  currency      String        @default("usd")
  paymentMethod String?
  transactionId String?
  userId        String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  orderId       String
  amount        Decimal?      @db.Decimal(10, 2)
  orders        orders        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  users         users         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, orderId, transactionId])
  @@map("payments")
}

model products {
  id          String        @id
  name        String
  description String?
  price       Decimal       @db.Decimal(10, 2)
  stock       Int           @default(0)
  sku         String        @unique
  imageUrl    String?
  isActive    Boolean       @default(false)
  categoryId  String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  cart_items  cart_items[]
  order_items order_items[]
  categories  categories    @relation(fields: [categoryId], references: [id])

  @@index([id, sku, categoryId, isActive])
  @@map("products")
}

model users {
  id           String     @id
  email        String     @unique
  firstName    String?
  lastName     String?
  password     String
  role         Role       @default(USER)
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  carts        carts[]
  orders       orders[]
  payments     payments[]

  @@index([email])
  @@map("users")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUND
}

enum Role {
  ADMIN
  USER
}
